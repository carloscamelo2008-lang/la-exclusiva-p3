# Keep text files consistent across Windows, macOS, and Linux
* text=auto

*.java text eol=lf
*.sql text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
