# Compiled Java classes and archives
*.class
*.jar
*.war
*.nar
*.ear

# Maven / build output
target/
build/
dist/
out/
nbbuild/
nbdist/
!**/src/**/build/

# IntelliJ IDEA
.idea/
*.iml

# NetBeans
/nbproject/private/
/.nb-gradle/

# Eclipse
.project
.classpath
.settings/

# Gradle caches
.gradle/

# Logs and JVM crash reports
*.log
hs_err_pid*
replay_pid*

# IDE/tool-generated tag files
*.tag
**/*.tag

# Temporary files, editor backups, patch leftovers
*.tmp
*.temp
*.swp
*.swo
*.bak
*.orig
*.rej
*~

# Local environment files and secrets
.env
.env.*
!.env.example
*.local

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Native installer/package output
*.app/
*.dmg
*.msi

# Local PostgreSQL data directories
.pgdata/
postgres-data/
postgresql-data/

# Do not ignore *.sql or *.csv globally:
# SQL scripts and intentional test/seed data may be required in the repository.
