# Compiled Java classes
*.class
*.ctxt

# Java archives and generated packages
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven / build output
target/
build/
dist/
out/
nbbuild/
nbdist/
!**/src/**/build/

# IntelliJ IDEA
.idea/
*.iml

# NetBeans
/nbproject/private/
/.nb-gradle/
.mtj.tmp/

# Eclipse
.project
.classpath
.settings/

# Gradle caches
.gradle/

# Logs and JVM crash reports
*.log
hs_err_pid*
replay_pid*

# IDE/tool-generated tag files
*.tag
**/*.tag

# Temporary files, editor backups, patch leftovers
*.tmp
*.temp
*.swp
*.swo
*.bak
*.orig
*.rej
*~

# Local environment files and secrets
.env
.env.*
!.env.example
*.local

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Local PostgreSQL data directories
.pgdata/
postgres-data/
postgresql-data/

# Runtime data files; keep curated examples under data/seed-*.csv
data/*.csv
data/*.dat
!data/seed-*.csv

# Do not ignore *.sql or *.csv globally:
# SQL scripts and intentionally curated seed data may be required.
