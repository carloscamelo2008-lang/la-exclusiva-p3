# Compiled Java classes and generated artifacts
*.class
*.jar
*.war
*.nar
*.ear

# Maven and build output
target/
build/
dist/
out/
nbbuild/
nbdist/
!**/src/**/build/

# IntelliJ IDEA
.idea/
*.iml

# NetBeans
/nbproject/private/
/.nb-gradle/

# Eclipse
.project
.classpath
.settings/

# Gradle
.gradle/

# Logs and JVM crash reports
*.log
hs_err_pid*
replay_pid*

# IDE/tool-generated tag files
*.tag
**/*.tag

# Temporary files, editor backups, and patch leftovers
*.tmp
*.temp
*.swp
*.swo
*.bak
*.orig
*.rej
*~

# Local environment and secrets
.env
.env.*
!.env.example
*.local

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Native installer/package output
*.app/
*.dmg
*.msi

# Local PostgreSQL data directories (never commit database clusters)
.pgdata/
postgres-data/
postgresql-data/

# Intentionally do not ignore *.sql or *.csv globally:
# database scripts and curated seed/test data may belong in version control.
