-- Este archivo se ejecuta únicamente en el PostgreSQL efímero del job autorizado.
\ir guard.psql
DO $empty$
BEGIN
    IF EXISTS (SELECT FROM pg_catalog.pg_class WHERE relnamespace = 'public'::regnamespace
               AND relkind IN ('r', 'p', 'v', 'm', 'f', 'S')) THEN
        RAISE EXCEPTION 'La composición de aplicación exige un laboratorio recién creado';
    END IF;
END;
$empty$;
\ir ../../migrations/V001__initial_schema.sql
\ir ../../migrations/V004__purchase_orders.sql
\ir ../../migrations/V002__payment_idempotency.sql
\ir ../../migrations/V100__sale_creation_idempotency.sql
\ir ../../migrations/V101__general_debt_ledger.sql
\ir ../../migrations/V102__cash_ledger.sql
\ir ../../migrations/V103__enforce_sale_request_identity_coherence.sql
\ir ../../migrations/V104__user_security_version.sql
\ir ../../migrations/V105__unique_active_user_seller.sql
\ir ../../migrations/V106__user_account_instance_identity.sql
\ir ../../migrations/V107__customer_collection_preferences.sql
\ir ../../migrations/V108__administrative_audit.sql

-- Fixtures efímeros para verificar la conversión segura de filas de V107/V108 antes de V109.
INSERT INTO public.customer (id,name,phone,address,balance)
VALUES ('IV_V109_LEGACY', 'Fixture de migración', '0000000000', 'Ficticia', 85000.00);
INSERT INTO public.customer_collection_reminder
  (customer_id,week_start,channel,status,balance_snapshot,generated_at,last_attempt_at,attempt_count,result_code)
VALUES ('IV_V109_LEGACY','2026-11-23','EMAIL','SENDING',85000.00,'2026-11-23 10:00:00',NULL,0,'PREPARED'),
       ('IV_V109_LEGACY','2026-11-30','EMAIL','FAILED',65000.00,'2026-11-23 10:00:00',
        '2026-11-23 10:05:00',1,'PROVIDER_FAILED');
\ir ../../migrations/V109__reminder_review_and_delivery_reconciliation.sql
DO $v109_backfill$
BEGIN
    IF (SELECT count(*) FROM customer_collection_reminder
        WHERE customer_id='IV_V109_LEGACY' AND status='RECONCILIATION_REQUIRED'
          AND result_code='PROVIDER_OUTCOME_UNCERTAIN' AND attempt_count >= 1
          AND attempt_id IS NOT NULL AND attempt_owner_id IS NULL
          AND provider_evidence='SMTP_OUTCOME_UNCERTAIN') <> 2
       OR (SELECT count(DISTINCT attempt_id) FROM customer_collection_reminder
           WHERE customer_id='IV_V109_LEGACY') <> 2 THEN
        RAISE EXCEPTION 'V109 no conservó como inciertos los intentos históricos sin certeza';
    END IF;
END;
$v109_backfill$;
DELETE FROM customer_collection_reminder WHERE customer_id='IV_V109_LEGACY';
UPDATE customer SET phone = '+57 300 000 0129' WHERE id='IV_V109_LEGACY';
\ir ../../migrations/V110__customer_phone_uniqueness.sql
\ir ../../migrations/V111__customer_credit_limit.sql
\ir ../../migrations/V112__audit_actors_and_payment_methods.sql
DO $customer_migrations$
BEGIN
    IF NOT EXISTS (SELECT FROM customer WHERE id = 'IV_V109_LEGACY'
                   AND phone = '573000000129' AND credit_limit = 0) THEN
        RAISE EXCEPTION 'V110 o V111 no aplicaron los valores esperados al cliente existente';
    END IF;
END;
$customer_migrations$;
UPDATE customer SET credit_limit = 5000.00 WHERE id='IV_V109_LEGACY';
INSERT INTO beer_product (id, name, volume_ml, units_per_basket, container_type, container_group)
VALUES ('IV_PRODUCT_IMAGE', 'Producto ficticio de laboratorio', 330, 24, 'NON_RETURNABLE_CAN', NULL);
\ir ../../migrations/V113__retire_customer_credit_limit.sql
\ir ../../migrations/V114__product_image_reference.sql
DO $customer_credit_history$
BEGIN
    IF NOT EXISTS (SELECT FROM customer WHERE id='IV_V109_LEGACY' AND legacy_credit_limit=5000.00) THEN
        RAISE EXCEPTION 'V113 no conservó el valor histórico del cupo';
    END IF;
END;
$customer_credit_history$;
DO $product_image_reference$
DECLARE
    constraint_name TEXT;
BEGIN
    IF NOT EXISTS (SELECT FROM beer_product WHERE id='IV_PRODUCT_IMAGE' AND image_filename IS NULL) THEN
        RAISE EXCEPTION 'V114 no conservó la fila histórica sin fotografía';
    END IF;
    UPDATE beer_product SET image_filename=repeat('a', 64) || '.png' WHERE id='IV_PRODUCT_IMAGE';
    BEGIN
        UPDATE beer_product SET image_filename='../foto.png' WHERE id='IV_PRODUCT_IMAGE';
        RAISE EXCEPTION 'V114 permitió una ruta de imagen fuera del almacén';
    EXCEPTION WHEN check_violation THEN
        GET STACKED DIAGNOSTICS constraint_name=CONSTRAINT_NAME;
        IF constraint_name <> 'ck_beer_product_image_filename' THEN RAISE; END IF;
    END;
END;
$product_image_reference$;
DELETE FROM beer_product WHERE id='IV_PRODUCT_IMAGE';
DELETE FROM customer WHERE id='IV_V109_LEGACY';
\echo 'Esquema completo aplicado al cluster temporal aislado.'
