<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.laexclusiva.ui.controller.InventoryController">
    <padding><Insets top="14.0" right="16.0" bottom="14.0" left="16.0" /></padding>
    <Label text="Catálogo e inventario" style="-fx-font-size: 21px; -fx-font-weight: bold;" />
    <TableView fx:id="inventoryTable" prefHeight="185.0">
        <columns>
            <TableColumn fx:id="productIdColumn" text="ID" prefWidth="170.0" />
            <TableColumn fx:id="productNameColumn" text="Producto" prefWidth="200.0" />
            <TableColumn fx:id="stockColumn" text="Unidades" prefWidth="100.0" />
            <TableColumn fx:id="basketsColumn" text="Canastas" prefWidth="100.0" />
            <TableColumn fx:id="looseColumn" text="Sueltas" prefWidth="100.0" />
        </columns>
    </TableView>
    <VBox fx:id="productRegistrationPane" spacing="5.0">
        <Label text="Registrar producto y precios" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
        <HBox spacing="6.0">
            <TextField fx:id="productIdField" promptText="ID del producto" prefWidth="125.0" />
            <TextField fx:id="productNameField" promptText="Nombre" prefWidth="190.0" />
            <TextField fx:id="volumeField" promptText="Volumen ml" prefWidth="90.0" />
            <TextField fx:id="unitsPerBasketField" promptText="Unidades/canasta" prefWidth="120.0" />
            <ComboBox fx:id="containerTypeCombo" promptText="Tipo de envase" prefWidth="175.0" />
        </HBox>
        <HBox spacing="6.0">
            <TextField fx:id="containerGroupField" promptText="Grupo de envase retornable" prefWidth="185.0" />
            <TextField fx:id="unitPriceField" promptText="Precio unidad" prefWidth="120.0" />
            <TextField fx:id="halfBasketPriceField" promptText="Precio media canasta" prefWidth="150.0" />
            <TextField fx:id="fullBasketPriceField" promptText="Precio canasta" prefWidth="125.0" />
            <Button fx:id="registerProductButton" text="Registrar producto" onAction="#handleRegisterProduct" />
        </HBox>
    </VBox>
    <HBox fx:id="stockEntryPane" spacing="8.0">
        <ComboBox fx:id="productCombo" promptText="Producto" prefWidth="220.0" />
        <TextField fx:id="fullBasketsField" text="0" promptText="Canastas" prefWidth="95.0" />
        <TextField fx:id="looseUnitsField" text="0" promptText="Unidades sueltas" prefWidth="120.0" />
        <TextField fx:id="reasonField" promptText="Motivo de entrada" prefWidth="220.0" />
        <Button fx:id="registerStockButton" text="Registrar entrada" onAction="#handleAddStock" />
    </HBox>
    <Label fx:id="messageLabel" wrapText="true" />
    <Button fx:id="refreshInventoryButton" text="Actualizar inventario" onAction="#handleRefreshInventory" />
    <Label text="Movimientos de inventario" style="-fx-font-size: 17px; -fx-font-weight: bold;" />
    <TableView fx:id="movementTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="movementProductColumn" text="Producto" prefWidth="180.0" />
            <TableColumn fx:id="movementTypeColumn" text="Tipo" prefWidth="90.0" />
            <TableColumn fx:id="movementUnitsColumn" text="Unidades" prefWidth="90.0" />
            <TableColumn fx:id="movementReasonColumn" text="Motivo" prefWidth="250.0" />
            <TableColumn fx:id="movementTimeColumn" text="Fecha" prefWidth="160.0" />
        </columns>
    </TableView>
</VBox>
