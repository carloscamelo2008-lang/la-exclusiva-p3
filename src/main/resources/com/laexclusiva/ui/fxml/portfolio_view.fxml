<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.laexclusiva.ui.controller.PortfolioController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>
    <Label text="Cartera pendiente" style="-fx-font-size: 22px;" />
    <Label fx:id="portfolioSubtitle"
           text="Consulta de saldos por cliente y registro de abonos a ventas." wrapText="true" />
    <TableView fx:id="portfolioTable" editable="false" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <placeholder>
            <Label text="No hay clientes con saldo pendiente" />
        </placeholder>
        <columns>
            <TableColumn fx:id="idColumn" text="ID del cliente" />
            <TableColumn fx:id="nameColumn" text="Nombre" />
            <TableColumn fx:id="balanceColumn" text="Saldo pendiente (COP)" />
        </columns>
    </TableView>
    <HBox spacing="12.0">
        <ComboBox fx:id="customerCombo" promptText="Cliente" prefWidth="220.0" />
        <Button fx:id="refreshPortfolioButton" text="Actualizar cartera" onAction="#handleRefreshPortfolio" />
        <Label fx:id="salesDebtLabel" text="Deuda de ventas: —" />
        <Label fx:id="generalDebtLabel" text="Deuda general: —" />
    </HBox>
    <Label text="Ventas pendientes del cliente" style="-fx-font-size: 17px; -fx-font-weight: bold;" />
    <TableView fx:id="salesTable" prefHeight="150.0">
        <columns>
            <TableColumn fx:id="saleIdColumn" text="Venta" prefWidth="350.0" />
            <TableColumn fx:id="saleTotalColumn" text="Total" prefWidth="120.0" />
            <TableColumn fx:id="salePaidColumn" text="Pagado" prefWidth="120.0" />
            <TableColumn fx:id="saleBalanceColumn" text="Pendiente" prefWidth="120.0" />
        </columns>
    </TableView>
    <HBox fx:id="paymentPane" spacing="8.0">
        <TextField fx:id="paymentAmountField" promptText="Abono (COP)" prefWidth="150.0" />
        <Button fx:id="registerPaymentButton" text="Registrar abono" onAction="#handleRegisterPayment" />
    </HBox>
    <Label fx:id="modeLabel" wrapText="true" />
    <Label fx:id="messageLabel" wrapText="true" />
</VBox>
