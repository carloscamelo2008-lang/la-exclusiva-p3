<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.laexclusiva.ui.controller.CustomerController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>
    <Label text="Clientes" style="-fx-font-size: 22px;" />
    <HBox fx:id="registrationPane" spacing="6.0">
        <TextField fx:id="idField" promptText="ID" prefWidth="100.0" />
        <TextField fx:id="nameField" promptText="Nombre" prefWidth="160.0" />
        <TextField fx:id="phoneField" promptText="Teléfono" prefWidth="120.0" />
        <TextField fx:id="addressField" promptText="Dirección" prefWidth="190.0" />
        <Button fx:id="registerCustomerButton" text="Registrar cliente" onAction="#handleRegisterCustomer" />
    </HBox>
    <Label fx:id="messageLabel" wrapText="true" />
    <TableView fx:id="customersTable" id="customersTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <placeholder>
            <Label text="No hay clientes registrados." />
        </placeholder>
        <columns>
            <TableColumn fx:id="idColumn" text="ID" />
            <TableColumn fx:id="nameColumn" text="Nombre" />
            <TableColumn fx:id="phoneColumn" text="Teléfono" />
            <TableColumn fx:id="addressColumn" text="Dirección" />
        </columns>
    </TableView>
</VBox>
