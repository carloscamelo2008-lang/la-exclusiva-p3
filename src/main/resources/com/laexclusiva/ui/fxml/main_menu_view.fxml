<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="rootPane" minHeight="500.0" minWidth="780.0" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.laexclusiva.ui.controller.MainController" stylesheets="@../css/navigation.css">
   <left>
      <VBox prefHeight="600.0" prefWidth="260.0" style="-fx-background-color: #2c3e50;" BorderPane.alignment="CENTER">
         <children>
            <Label text="LA EXCLUSIVA" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="20.0" left="20.0" top="25.0" />
               </VBox.margin>
            </Label>
            <Button fx:id="btnDashboard" onAction="#handleShowDashboard" mnemonicParsing="false" prefHeight="40.0" prefWidth="260.0" styleClass="nav-button" text="Resumen / Inicio">
               <padding>
                  <Insets left="20.0" top="10.0" />
               </padding>
            </Button>
            <Button fx:id="btnCustomers" onAction="#handleShowCustomers" mnemonicParsing="false" prefHeight="40.0" prefWidth="260.0" styleClass="nav-button" text="Clientes">
               <padding>
                  <Insets left="20.0" top="10.0" />
               </padding>
            </Button>
            <Button fx:id="btnSellers" onAction="#handleShowSellers" mnemonicParsing="false" prefHeight="40.0" prefWidth="260.0" styleClass="nav-button" text="Vendedores">
               <padding>
                  <Insets left="20.0" top="10.0" />
               </padding>
            </Button>
            <Button fx:id="btnCredit" onAction="#handleShowPortfolio" mnemonicParsing="false" prefHeight="40.0" prefWidth="260.0" styleClass="nav-button" text="Cartera (consulta)">
               <padding>
                  <Insets left="20.0" top="10.0" />
               </padding>
            </Button>
            <Button fx:id="btnCash" onAction="#handleShowCash" mnemonicParsing="false" prefHeight="40.0" prefWidth="260.0" styleClass="nav-button" text="Caja y movimientos">
               <padding>
                  <Insets left="20.0" top="10.0" />
               </padding>
            </Button>
            <Button fx:id="btnInventory" onAction="#handleShowInventory" mnemonicParsing="false" prefHeight="40.0" prefWidth="260.0" styleClass="nav-button" text="Catálogo e Inventario">
               <padding>
                  <Insets left="20.0" top="10.0" />
               </padding>
            </Button>
            <Button fx:id="btnSales" onAction="#handleShowSales" mnemonicParsing="false" prefHeight="40.0" prefWidth="260.0" styleClass="nav-button" text="Registrar Venta">
               <padding>
                  <Insets left="20.0" top="10.0" />
               </padding>
            </Button>
            <Button fx:id="btnAdminUsers" onAction="#handleShowAdminUsers" mnemonicParsing="false" prefHeight="64.0" prefWidth="260.0" styleClass="nav-button" wrapText="true" text="Gestión de Usuarios">
               <padding>
                  <Insets left="20.0" top="10.0" />
               </padding>
            </Button>
            <Button fx:id="btnLogout" onAction="#handleLogout" text="Cerrar sesión" styleClass="nav-button" prefWidth="260.0" />
         </children>
      </VBox>
   </left>
   <center>
      <VBox fx:id="dashboard" alignment="CENTER" prefHeight="200.0" prefWidth="100.0" style="-fx-background-color: #ecf0f1;" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="welcomeLabel" text="Bienvenido al Sistema">
               <font>
                  <Font size="22.0" />
               </font>
            </Label>
            <Label fx:id="roleLabel" text="Rol: " textFill="#42515c">
               <font>
                  <Font size="16.0" />
               </font>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Label>
         </children>
      </VBox>
   </center>
   <bottom>
      <Label fx:id="navigationMessage" style="-fx-text-fill: #a01818;" />
   </bottom>
</BorderPane>
