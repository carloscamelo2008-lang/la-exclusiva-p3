<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.laexclusiva.ui.controller.LoginController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="LA EXCLUSIVA" />
    <Label style="-fx-font-size: 14px; -fx-text-fill: gray;" text="Gestión clara para cada operación" />

    <VBox spacing="8.0" style="-fx-max-width: 300px;">
        <Label text="Usuario" />
        <TextField fx:id="usernameField" promptText="Ingrese su usuario" />
        
        <Label text="Contraseña" />
        <PasswordField fx:id="passwordField" promptText="********" />
    </VBox>

    <Button fx:id="loginButton" defaultButton="true" onAction="#handleLogin" style="-fx-background-color: #0d7342; -fx-text-fill: white; -fx-font-weight: bold;" text="Iniciar sesión" prefWidth="300.0" />

    <Label fx:id="errorLabel" style="-fx-text-fill: red;" text="" />
</VBox>