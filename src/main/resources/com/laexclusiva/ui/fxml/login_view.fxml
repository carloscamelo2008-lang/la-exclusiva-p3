<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.laexclusiva.ui.controller.LoginController" stylesheets="@../css/theme.css" styleClass="login-shell">
    <padding>
        <Insets bottom="18.0" left="28.0" right="28.0" top="18.0" />
    </padding>

    <Label styleClass="login-title" text="LA EXCLUSIVA" />
    <Label styleClass="login-subtitle" text="Gestión clara para cada operación" />

    <VBox spacing="8.0" style="-fx-max-width: 300px;">
        <Label text="Usuario" />
        <TextField fx:id="usernameField" promptText="Ingrese su usuario" />
        
        <Label text="Contraseña" />
        <PasswordField fx:id="passwordField" promptText="********" />
    </VBox>

    <Button fx:id="loginButton" defaultButton="true" onAction="#handleLogin"  text="Iniciar sesión" prefWidth="300.0" />

    <Label fx:id="errorLabel" styleClass="login-error" wrapText="true" text="" />
</VBox>